            "post": {
                "tags": [
                    "Distribution"
                ],
                "summary": "إنشاء أمر صرف (تحميل للمندوب)",
                "operationId": "5f7e80f07eda221c6bc31139b764548d",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "order_no",
                                    "warehouse_id",
                                    "representative_id",
                                    "order_date",
                                    "items"
                                ],
                                "properties": {
                                    "order_no": {
                                        "type": "string",
                                        "example": "DO-001"
                                    },
                                    "warehouse_id": {
                                        "type": "integer"
                                    },
                                    "representative_id": {
                                        "type": "integer"
                                    },
                                    "order_date": {
                                        "type": "string",
                                        "format": "date"
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "draft",
                                            "pending",
                                            "approved",
                                            "cancelled"
                                        ]
                                    },
                                    "notes": {
                                        "type": "string"
                                    },
                                    "items": {
                                        "type": "array",
                                        "items": {
                                            "properties": {
                                                "product_id": {
                                                    "type": "integer"
                                                },
                                                "quantity": {
                                                    "type": "number"
                                                },
                                                "unit_cost": {
                                                    "type": "number"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "تم الإنشاء"
                    }
                },
                "security": [
                    {
                        "sanctum": []
                    }
                ]
            }
        },
